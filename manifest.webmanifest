{
  "name": "AI・DX定例会",
  "short_name": "AI・DX定例会",
  "description": "AI・DX推進委員会 定例会の日程・議事録・資料管理",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#1d4f91",
  "lang": "ja",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+aidxteireikai",
      "url": "./?open=%s"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}